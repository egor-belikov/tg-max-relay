# Тот же бот, что kinodolgoletie (kinodolgoletiebot).
API_TOKEN=

# Max API (maxapi), как в kinodolgoletie.
MAX_API_TOKEN=

# Опционально: свой хост Telegram API (зеркало). Иначе api.telegram.org.
# TELEGRAM_API_URL=https://api.telegram.org

# Мастер-тумблер релея (по умолчанию включён). Выключить: 0
# ENABLE_TG_TO_MAX_RELAY=1

# Хендлеры в этом процессе обычно всегда включаем:
# ENABLE_TELEGRAM_MAX_RELAY_BOT=1

# Подробный JSONL-лог релея в DATA_DIR/tg_max_relay_diag.jsonl
# ENABLE_TG_MAX_RELAY_DIAG_LOG=1

# Лог событий max_bot_activity.log (как в основном боте)
# ENABLE_MAX_ACTIVITY_LOG=1
